{
  "realm": "morhent",
  "displayName": "Morhent",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "agent",
        "description": "Agent d'agence Morhent"
      },
      {
        "name": "manager",
        "description": "Responsable des agences"
      },
      {
        "name": "admin",
        "description": "Administrateur de l'application Morhent"
      }
    ]
  },
  "groups": [
    {
      "name": "agents",
      "path": "/agents",
      "realmRoles": [
        "agent"
      ],
      "subGroups": []
    },
    {
      "name": "managers",
      "path": "/managers",
      "realmRoles": [
        "manager"
      ],
      "subGroups": []
    },
    {
      "name": "admins",
      "path": "/admins",
      "realmRoles": [
        "admin"
      ],
      "subGroups": []
    }
  ],
  "users": [
    {
      "username": "yann.legoff",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Yann",
      "lastName": "Le Goff",
      "email": "yann.legoff@morhent.test",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/agents"
      ],
      "requiredActions": [],
      "attributes": {
        "agence": [
          "brest-aeroport"
        ]
      }
    },
    {
      "username": "claire.daniel",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Claire",
      "lastName": "Daniel",
      "email": "claire.daniel@morhent.test",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/managers"
      ],
      "requiredActions": []
    },
    {
      "username": "erwan.kerherve",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Erwan",
      "lastName": "Kerhervé",
      "email": "erwan.kerherve@morhent.test",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": [
        "/admins"
      ],
      "requiredActions": []
    }
  ],
  "clients": [
    {
      "clientId": "morhent-backoffice",
      "name": "Morhent back-office",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-a-changer",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://morhent.localhost",
      "baseUrl": "/admin",
      "redirectUris": [
        "http://morhent.localhost/*",
        "https://morhent.example.com/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://morhent.localhost/*##https://morhent.example.com/*"
      },
      "protocolMappers": [
        {
          "name": "groupes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "agence",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "agence",
            "claim.name": "agence",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_VIEW\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"agence\", \"displayName\": \"Agence\", \"validations\": {\"options\": {\"options\": [\"rennes-gare\", \"brest-aeroport\", \"quimper-centre\"]}}, \"annotations\": {\"inputType\": \"select\"}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}